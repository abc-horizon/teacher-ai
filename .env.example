# Copy this file to .env and fill in real values locally.
# Never commit a real .env file or real credentials.

# Application
APP_ENV=development

# The application's OWN database (app/db.py) - the one this project writes to.
# Leave blank to use the local SQLite dev file app_dev.db, which is the normal
# setup for development. Set it only to move the app onto a real server:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/btek
#   DATABASE_URL=mysql+pymysql://user:pass@host:3306/btek
# A non-SQLite URL needs its driver installed (psycopg for PostgreSQL).
# Note: this is NOT Moodle's database - that is the MOODLE_DB_* block below.
DATABASE_URL=

# Moodle integration (Web Services API)
MOODLE_URL=
MOODLE_TOKEN=

# Direct read-only SQL access to Moodle (app/extractor/moodle_db.py).
# Only needed for the two things no Web Service exposes: BTEC criterion text
# and the teacher's per-criterion remarks. Leave blank to run API-only —
# the app degrades gracefully and falls back to sample_data/ fixtures.
# The database user MUST have SELECT privilege only.
# Moodle binds its DB to localhost, so MOODLE_DB_HOST is normally the local
# end of an SSH tunnel:  ssh -N -L 3307:127.0.0.1:3306 user@server
MOODLE_DB_TYPE=mariadb
MOODLE_DB_HOST=
MOODLE_DB_PORT=
MOODLE_DB_NAME=
MOODLE_DB_USER=
MOODLE_DB_PASSWORD=
MOODLE_DB_PREFIX=mdl_

# AI / LLM provider (to be configured in a later task)
LLM_API_KEY=

# Optional override; defaults to deepseek-v4-flash if unset
LLM_MODEL=
