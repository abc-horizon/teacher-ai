# Environment / secrets
# `.env` alone matches only that exact name, so a `.env.bak` / `.env.local`
# holding the same DB password would be committed. Ignore every variant and
# re-allow the credential-free template explicitly.
.env
.env.*
!.env.example

# Databases
*.db

# Temporary downloads
tmp_downloads/

# Python virtual environments
.venv/
venv/

# Python cache/build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Real student / private data - never commit
student_data/
private_data/
sample_data/real/
*.student.*
